# Required: OpenAI API key with Realtime API access
OPENAI_API_KEY=sk-...

# Optional: OpenAI model (default: gpt-4o-realtime-preview)
MODEL_NAME=gpt-4o-realtime-preview

# Optional: Robot names for multi-robot discovery on same subnet
# Leave blank to auto-detect (works if only one robot on subnet)
ROBOT_A_NAME=
ROBOT_B_NAME=

# Optional: Voice selection (default: coral for student, sage for professor)
ROBOT_A_VOICE=coral
ROBOT_B_VOICE=sage

# Optional: Pause between turns in seconds (default: 1.0)
INTER_TURN_PAUSE=1.0

# macOS (Homebrew): Required for Reachy Mini SDK GStreamer support.
# These must be exported BEFORE launching Python.
GI_TYPELIB_PATH=/opt/homebrew/lib/girepository-1.0
DYLD_LIBRARY_PATH=/opt/homebrew/lib
GST_PLUGIN_PATH=/opt/homebrew/lib/gstreamer-1.0
