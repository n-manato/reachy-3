# Required: OpenAI API key (used for text generation only — audio is ElevenLabs)
OPENAI_API_KEY=sk-...

# Required: ElevenLabs API key (used for all robot voice synthesis)
ELEVENLABS_API_KEY=

# Optional: OpenAI model (default: gpt-4o-realtime-preview)
MODEL_NAME=gpt-4o-realtime-preview

# Robot connection — set host (IP or mDNS name) for each robot.
# Leave blank to auto-detect (works only if one robot on the subnet).
ROBOT_A_NAME=
ROBOT_A_HOST=reachy-mini.local
ROBOT_B_NAME=
ROBOT_B_HOST=reachy-mini.local
ROBOT_C_NAME=
ROBOT_C_HOST=reachy-mini.local

# ── ElevenLabs voices (default picks are the philosopher-fit voices) ─────────
# Robot A = Bentham-Bot   = George   (warm British storyteller)
# Robot B = Korsgaard-Bot = Matilda  (calm, principled female academic)
# Robot C = Aquinas-Bot   = Bill     (warm, mature, deliberate narrator)
ROBOT_A_VOICE=JBFqnCBsd6RMkjVDRZzb
ROBOT_B_VOICE=XrExE9yKIg1WjnnlVkGX
ROBOT_C_VOICE=pqHfZKP75CvOlQylNhV4

# ElevenLabs model — eleven_flash_v2_5 gives ~75ms TTFB for live exhibits.
# Switch to eleven_multilingual_v2 for higher-quality offline rendering.
ELEVENLABS_MODEL=eleven_flash_v2_5

# Optional: Pause between turns in seconds (default: 1.0)
INTER_TURN_PAUSE=1.0

# Note: GStreamer environment variables (GI_TYPELIB_PATH, DYLD_LIBRARY_PATH,
# GST_PLUGIN_PATH) are NOT set here — `scripts/run.py` handles them
# automatically per platform (macOS auto-detects Homebrew prefix, Linux uses
# system gstreamer, Windows uses the bundled gstreamer-msvc-runtime).
