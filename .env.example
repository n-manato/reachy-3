# ── Keys (generation only; the show itself runs offline) ───────────────────
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Model that drafts the scripts (menu 1).
SCRIPT_MODEL=gpt-5
# TTS model (menu 2). eleven_multilingual_v2 is the reliable English choice.
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Cast ───────────────────────────────────────────────────────────────────
#   NOVA  / left   / Chief Innovation Officer   (The Accelerator)
#   SAGE  / center / Chief People Officer, host (The Bridge)
#   AEGIS / right  / Chief Risk & Trust Officer (The Guardian)
NOVA_VOICE=JBFqnCBsd6RMkjVDRZzb
SAGE_VOICE=XrExE9yKIg1WjnnlVkGX
AEGIS_VOICE=pqHfZKP75CvOlQylNhV4

# Robots are addressed by IP, never mDNS (every unit is called reachy-mini).
NOVA_NAME="reachy_mini"
NOVA_HOST=192.168.3.163
SAGE_NAME="reachy_mini"
SAGE_HOST=192.168.3.106
AEGIS_NAME="reachy_mini"
AEGIS_HOST=192.168.3.132

# ROBOT_MODE=2 runs with one seat empty (its voice plays from the screen).
ROBOT_MODE=3
DISABLED_ROLE=

# ── Audio ──────────────────────────────────────────────────────────────────
#   robot    each line plays on the speaking robot's own speaker (HTTP play_sound)
#   display  every line plays from the center screen's browser, panned per seat
AUDIO_OUTPUT=robot
# Lead time added before the subtitle so it lands with the robot's voice.
ROBOT_AUDIO_LATENCY=0.15
# Robot speakers: clips are sent this many dB louder through a limiter
# (8 = about twice as loud; 0 = as rendered). Volume itself is set from the screens.
ROBOT_GAIN_DB=8
INTER_TURN_PAUSE=0.5

# ── Show ───────────────────────────────────────────────────────────────────
VOTE_SECONDS=20
# Idle seconds on the attract screen before the next topic starts on its own.
ATTRACT_SECONDS=45
# 1 = start a topic by itself after ATTRACT_SECONDS; 0 = wait for a tap.
AUTO_START=1

# ── Display ────────────────────────────────────────────────────────────────
DISPLAY_WEB_HOST=0.0.0.0
DISPLAY_WEB_PORT=8020
DISPLAY_SPEECH_BITRATE=48
