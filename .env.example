# ── ElevenLabs (all robot speech) ───────────────────────────────────────────
ELEVENLABS_API_KEY=

# TTS model. Set by scripts/probe_tts.py, which tries these in order and keeps
# the first one the account can actually use:
#   eleven_v3               70+ languages, best for Swahili/Fulfulde (may be
#                           unavailable -- no library voice on this account
#                           lists it, and the key lacks `models_read`)
#   eleven_multilingual_v2  the reliable high-quality offline choice
#   eleven_flash_v2_5       fastest, weakest on non-English
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Cast ────────────────────────────────────────────────────────────────────
# Robot A = ZURI   / left   / Swahili  -- cheerful, laughs a lot
# Robot B = KORA   / center / English  -- the host and (unreliable) interpreter
# Robot C = PULAAR / right  / Fulfulde -- deadpan; secretly understands English
#
# Voice ids below are African-accented voices already in this account's library.
# List every available voice with:  uv run python scripts/list_voices.py
ZURI_VOICE=PSIwmc50KeuW20kehlBE
KORA_VOICE=G2LDKmwqqBo2DD9ucIji
PULAAR_VOICE=8dvhVJc85Oy9HBPo11aI

# ── Robot connection ────────────────────────────────────────────────────────
# Twelve Reachy Minis share the Speedefy_5G robot-only WiFi (192.168.3.0/24 on
# this host's wlx984827b2551a), and every unit ships with the same mDNS name,
# so ours are identified by MAC, not by scan order:
#   A ZURI   / left    reachy-mini-2   88:a2:9e:78:39:7e
#   B KORA   / center  reachy-mini     88:a2:9e:e6:94:68
#   C PULAAR / right   reachy-mini-3   88:a2:9e:77:c7:36
# These are DHCP leases; if the router reboots, re-map MAC -> IP with
#   ip neigh show dev wlx984827b2551a
ZURI_NAME="reachy_mini"
ZURI_HOST=192.168.3.163
KORA_NAME="reachy_mini"
KORA_HOST=192.168.3.106
PULAAR_NAME="reachy_mini"
PULAAR_HOST=192.168.3.132

# ROBOT_MODE=3 (default) drives all three robots. ROBOT_MODE=2 runs the show
# with one robot physically absent -- its voice still plays through the TV at
# its usual pan position, only the hardware is skipped.
ROBOT_MODE=3
# Which seat is absent when ROBOT_MODE=2. Accepts: zuri/left, kora/center,
# pulaar/right.
DISABLED_ROLE=

# Pause between turns, seconds. Short for a comedy sketch — the head-posture
# choreography already adds about a second of its own between speakers.
INTER_TURN_PAUSE=0.4

# ── LLM (line-variation only, never during the show) ────────────────────────
# Default is Nexus's Ollama backend, hit directly. The Nexus gateway itself
# (http://localhost:3000/v1 + LAG_API_KEY) is the alternative, but its LLM Chat
# route is currently Disabled in the DB and its vLLM backend is down.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3.6:35b-a3b-q6_K_L
LLM_API_KEY=ollama
# Comma-separated turn numbers to rephrase. Empty = fully fixed script.
VARY_LINES=1,3,7,23,25,29
# How many pre-rendered variants to build (v01 is always the verbatim script).
VARIANT_COUNT=5

# ── Display ─────────────────────────────────────────────────────────────────
# One TV runs http://<this-pc-ip>:8010/top in a kiosk browser, and that browser
# is what emits the speech and BGM into the surround system.
DISPLAY_WEB_HOST=0.0.0.0
DISPLAY_WEB_PORT=8010
# MP3 bitrate for speech served to the browser (kbps, mono).
DISPLAY_SPEECH_BITRATE=48
# How the exhibit chooses what to play next. The operator can change this from
# the display at any time; this is only the mode it starts in.
#   shuffle     every variant once in a random order, then reshuffle
#   sequential  v01, v02, ... and back to v01
#   one         always v01, the script exactly as written
LOOP_MODE=shuffle

# Seconds of attract screen between runs of the sketch.
ATTRACT_SECONDS=20
