# Required: OpenAI API key (used for text generation only — audio is ElevenLabs)
OPENAI_API_KEY=sk-...

# Required: ElevenLabs API key (used for all robot voice synthesis)
ELEVENLABS_API_KEY=

# Optional: OpenAI model (default: gpt-4o-realtime-preview)
MODEL_NAME=gpt-4o-realtime-preview

# Robot connection — set host (IP or mDNS name) for each robot.
# Leave blank to auto-detect (works only if one robot on the subnet).
ROBOT_A_NAME=
ROBOT_A_HOST=reachy-mini.local
ROBOT_B_NAME=
ROBOT_B_HOST=reachy-mini.local
ROBOT_C_NAME=
ROBOT_C_HOST=reachy-mini.local

# ── Robot count mode (2 vs 3 robots) ────────────────────────────────────────
# ROBOT_MODE=3 (default) drives all three robots.
# ROBOT_MODE=2 runs the exhibit with one robot physically absent (e.g. a broken
# unit). The conversation content stays 3-person, so the absent robot's voice
# still plays through the TV / browser audio at its usual pan position — only
# the physical robot is skipped (no connection, no motion, no restart hang).
# Switch back to 3 robots by setting ROBOT_MODE=3 (or removing this line).
ROBOT_MODE=3
# Which seat is absent when ROBOT_MODE=2 (ignored in 3-robot mode).
# Accepts: professor / korsgaard / center (default), student / bentham / left,
#          moderator / aquinas / right.
DISABLED_ROLE=professor

# ── ElevenLabs voices (default picks are the philosopher-fit voices) ─────────
# Robot A = Bentham-Bot   = George   (warm British storyteller)
# Robot B = Korsgaard-Bot = Matilda  (calm, principled female academic)
# Robot C = Aquinas-Bot   = Bill     (warm, mature, deliberate narrator)
ROBOT_A_VOICE=JBFqnCBsd6RMkjVDRZzb
ROBOT_B_VOICE=XrExE9yKIg1WjnnlVkGX
ROBOT_C_VOICE=pqHfZKP75CvOlQylNhV4

# ElevenLabs model — eleven_flash_v2_5 gives ~75ms TTFB for live exhibits.
# Switch to eleven_multilingual_v2 for higher-quality offline rendering.
ELEVENLABS_MODEL=eleven_flash_v2_5

# Optional: Pause between turns in seconds (default: 1.0)
INTER_TURN_PAUSE=1.0

# ── Multi-Display Exhibit layout ────────────────────────────────────────────
# Only used by the "Multi-Display Exhibit" play mode. The exhibit uses 4 screens:
# one large portrait top display (1080x1980) above the robots, plus one mini
# display under each robot.
#
# Monitor index for the large top display (0 = primary screen).
DISPLAY_TOP_MONITOR=0
# Monitor index for each mini display, in order: student,professor,moderator
# (= Bentham-Bot/Left, Korsgaard-Bot/Center, Aquinas-Bot/Right).
DISPLAY_MINI_MONITORS=1,2,3
# When true — or when fewer than 4 monitors are connected — all four windows
# are tiled on the primary screen so the flow can be tested on one machine.
DISPLAY_TEST_MODE=false

# ── Display backend ──────────────────────────────────────────────────────────
# How the Multi-Display Exhibit renders:
#   qt  = four native PySide6 windows on locally-attached monitors (default)
#   web = browser pages served over the LAN. Open one per display on any
#         computer on the same network:
#           http://<this-pc-ip>:8000/top
#           http://<this-pc-ip>:8000/student   (professor / moderator)
#           http://<this-pc-ip>:8000/all        (all four tiled — for testing)
# Audio (robot speech + video sound) still plays from THIS machine in both modes.
DISPLAY_BACKEND=qt
# Web backend bind address + port. 0.0.0.0 = reachable from any LAN device.
DISPLAY_WEB_HOST=0.0.0.0
DISPLAY_WEB_PORT=8000

# Note: GStreamer environment variables (GI_TYPELIB_PATH, DYLD_LIBRARY_PATH,
# GST_PLUGIN_PATH) are NOT set here — `scripts/run.py` handles them
# automatically per platform (macOS auto-detects Homebrew prefix, Linux uses
# system gstreamer, Windows uses the bundled gstreamer-msvc-runtime).
